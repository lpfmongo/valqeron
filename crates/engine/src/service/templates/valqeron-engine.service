[Unit]
Description=Valqeron engine daemon
Documentation=https://github.com/lfreitas2012/valqeron
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
ExecStart="{{EXE}}" run
Restart=on-failure
RestartSec=5
KillSignal=SIGTERM
# Must exceed the engine's internal drain (10s) + runtime shutdown (20s)
# bounds so a graceful stop is never truncated mid-checkpoint.
TimeoutStopSec=40
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths={{RW_PATHS}}
{{ENV_BLOCK}}
[Install]
WantedBy=default.target
